direction: down
vars: {
  d2-config: {
    layout-engine: elk
    sketch: true
  }
}

title: |md
  # Meet Live — Before & After
| {near: top-center}

classes: {
  section: {
    style: {
      fill: "#f8f9fa"
      stroke: "#dadce0"
      stroke-width: 2
      border-radius: 10
      font-size: 14
    }
  }
  added: {
    style: {
      fill: "#e6f4ea"
      stroke: "#34a853"
      stroke-width: 2
      stroke-dash: 3
      border-radius: 6
    }
  }
  removed: {
    style: {
      fill: "#fce8e6"
      stroke: "#ea4335"
      stroke-width: 1
      stroke-dash: 5
      border-radius: 6
    }
  }
  unchanged: {
    style: {
      fill: "#e8f0fe"
      stroke: "#4285f4"
      stroke-width: 2
      border-radius: 6
    }
  }
}

before: Meet Live Architect (Before) {
  class: section

  b_trigger: Manual Connect\nButton {
    class: removed
    shape: rectangle
  }
  b_panel: Side Panel UI\n(Lit / TypeScript) {
    class: unchanged
    shape: rectangle
  }
  b_media: Meet Media API\n(WebRTC) {
    class: unchanged
    shape: rectangle
  }
  b_pcm: PCM AudioWorklet\n(always streaming when on) {
    class: unchanged
    shape: rectangle
  }
  b_ws: WebSocket → Cloud Run {
    class: unchanged
    shape: rectangle
  }
  b_gemini: Gemini Live 2.5 Flash\n(audio only) {
    class: unchanged
    shape: rectangle
  }

  b_trigger -> b_panel
  b_panel -> b_media: join
  b_media -> b_pcm: audio tracks
  b_pcm -> b_ws: PCM frames
  b_ws -> b_gemini: stream
  b_gemini -> b_ws: audio response
  b_ws -> b_panel: playback
}

after: Meet Live Concierge (After) {
  class: section

  a_wake: Hey Gemini\nWake Word (Web Speech API) {
    class: added
    shape: rectangle
  }
  a_panel: Side Panel UI\n(Lit / TypeScript) {
    class: unchanged
    shape: rectangle
  }
  a_media: Meet Media API\n(WebRTC) {
    class: unchanged
    shape: rectangle
  }
  a_pcm: PCM AudioWorklet\n(gated by wake word) {
    class: unchanged
    shape: rectangle
  }
  a_ws: WebSocket → Cloud Run {
    class: unchanged
    shape: rectangle
  }
  a_gemini: Gemini Live 2.5 Flash\n(audio + function calling) {
    class: unchanged
    shape: rectangle
  }
  a_tool: Workspace Agent Tool\n(Agent Engine) {
    class: added
    shape: rectangle
  }
  a_drive: Google Drive & Docs {
    class: added
    shape: cylinder
  }
  a_links: Action Link Buttons\nin side panel {
    class: added
    shape: rectangle
  }

  a_wake -> a_pcm: activates on wake word
  a_panel -> a_media: join (on connect)
  a_media -> a_pcm: audio tracks
  a_pcm -> a_ws: PCM frames
  a_ws -> a_gemini: stream
  a_gemini -> a_tool: function_call
  a_tool -> a_drive: create / find
  a_drive -> a_tool: URL
  a_tool -> a_gemini: tool_response
  a_gemini -> a_ws: audio response
  a_ws -> a_panel: playback + action_link
  a_panel -> a_links: renders doc button
}
