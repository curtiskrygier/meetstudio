direction: right
vars: {
  d2-config: {
    layout-engine: elk
    sketch: true
  }
}

title: |md
  # Meet Live Concierge — Extended Architecture
| {near: top-center}

classes: {
  gcp: {
    style: {
      fill: "#e8f0fe"
      stroke: "#4285f4"
      stroke-width: 2
      border-radius: 8
    }
  }
  browser: {
    style: {
      fill: "#e6f4ea"
      stroke: "#34a853"
      stroke-width: 2
      border-radius: 8
    }
  }
  new_feature: {
    style: {
      fill: "#e6f4ea"
      stroke: "#34a853"
      stroke-width: 2
      stroke-dash: 3
      border-radius: 6
    }
  }
}

meet: Google Meet Browser {
  class: browser

  appsdk: Meet Add-on SDK {shape: rectangle}

  panel: Side Panel UI\n(Lit / TypeScript) {
    shape: rectangle
    style: {
      fill: "#fff8e1"
      stroke: "#fbbc04"
      stroke-width: 2
    }
  }

  wake: Web Speech API\nWake Word Listener {
    class: new_feature
    shape: rectangle
  }

  media: Meet Media API\n(WebRTC) {shape: rectangle}
  worklet: PCM AudioWorklet\n16 kHz {shape: rectangle}
  playback: Audio Playback\n24 kHz {shape: rectangle}

  action_links: Action Link Buttons\n(doc URLs) {
    class: new_feature
    shape: rectangle
  }

  appsdk -> panel
  wake -> worklet: activates PCM\non "Hey Gemini"
  media -> worklet: audio tracks
  panel -> action_links: renders on action_link msg
}

cloud_run: Cloud Run — FastAPI {
  class: gcp

  ws: WebSocket /ws {shape: rectangle}
  session: Gemini Live Session\n(with tools) {shape: rectangle}
  tool_handler: call_workspace_agent\ntool executor {
    class: new_feature
    shape: rectangle
  }

  ws -> session
  session -> tool_handler: on function_call
}

vertex: Vertex AI\nGemini Live 2.5 Flash\n(native audio + tools) {
  shape: cloud
  style: {
    fill: "#e8f0fe"
    stroke: "#4285f4"
    stroke-width: 2
  }
}

agent_engine: Agent Engine\nworkspace-subagent {
  class: new_feature
  shape: cloud
  style: {
    fill: "#e6f4ea"
    stroke: "#34a853"
    stroke-width: 2
  }
}

gdocs: Google Drive\n& Docs {
  shape: cylinder
  style: {
    fill: "#fff8e1"
    stroke: "#fbbc04"
  }
}

apps_script: Apps Script\nManifest {
  shape: document
  style: {
    fill: "#f3e8fd"
    stroke: "#9c27b0"
  }
}

apps_script -> meet.appsdk: registers sidePanelUrl
meet.worklet -> cloud_run.ws: PCM frames\n(WebSocket, 100 ms)
cloud_run.session -> vertex: audio stream
vertex -> cloud_run.session: audio + transcript\n+ function_call
cloud_run.ws -> meet.panel: audio bytes + transcript\n+ action_link msg
meet.panel -> meet.playback: schedule audio
cloud_run.tool_handler -> agent_engine: streamQuery POST\n(Vertex AI REST)
agent_engine -> gdocs: create / find docs
agent_engine -> cloud_run.tool_handler: result text + URL
cloud_run.session -> vertex: tool_response
