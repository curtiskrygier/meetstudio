"Ingestion/Source": {
  "Meet Add-on".icon: "/app/assets/icons/meet.svg"
  "Meet Add-on".shape: rectangle
  "Media API".shape: rectangle
}
"AI Processing": {
  "FastAPI Gateway".icon: "/app/assets/icons/cloud_run.svg"
  "FastAPI Gateway".shape: rectangle
  "AI Reasoning": {
    "Gemini Live API".icon: "/app/assets/icons/gemini.svg"
    "Gemini Live API".shape: rectangle
    "Architect Agent".icon: "/app/assets/icons/vertex_ai.svg"
    "Architect Agent".shape: rectangle
  }
  "D2 Renderer".shape: rectangle
}
"Storage/Output": {
  "Main Stage".icon: "/app/assets/icons/meet.svg"
  "Main Stage".shape: rectangle
  "Drive Archive".icon: "/app/assets/icons/drive.svg"
  "Drive Archive".shape: cylinder
}

"Meet Add-on" -> "Media API": "1. Streams PCM Audio"
"Media API" -> "FastAPI Gateway": "2. Captures Audio Chunks"
"FastAPI Gateway" -> "Gemini Live API": "3. Pipes via WebSockets"
"Gemini Live API" -> "Architect Agent": "4. Streams Real-time Transcript"
"Architect Agent" -> "D2 Renderer": "5. Generates D2 Code"
"D2 Renderer" -> "Main Stage": "6. Broadcasts Live SVG"
"Architect Agent" -> "Drive Archive": "7. Archives D2 Code"