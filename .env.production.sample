# Build-time variables (baked into the frontend bundle by Vite)
CLIENT_ID=YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com
CLOUD_PROJECT_NUMBER=YOUR_CLOUD_PROJECT_NUMBER

# Runtime variables (passed to Cloud Run via --set-env-vars)
GEMINI_PROJECT=your-gemini-billing-project-id
REGION=us-central1
KORE_VOICE=Charon
WORKSPACE_AGENT_ENGINE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/YOUR_ENGINE_ID

# Optional: protects the /mcp endpoint with Bearer auth (recommended for production)
# STAGE_API_KEY=your-secret-key
