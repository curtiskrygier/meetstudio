# Google Cloud project number (numeric) — shown in GCP Console > Home
CLOUD_PROJECT_NUMBER=

# OAuth 2.0 Client ID for the Meet Add-on (Web application type)
# Create at GCP Console > APIs & Services > Credentials
CLIENT_ID=

# GCP project ID that hosts the Gemini Live API (billing project)
GEMINI_PROJECT=

# Cloud Run region (default: us-central1)
REGION=us-central1

# Gemini Live voice — options: Puck, Charon, Kore, Fenrir, Aoede, Zephyr
KORE_VOICE=Kore

# Optional: override the agent system prompt
# SYSTEM_PROMPT=You are an AI assistant embedded in a Google Meet call...
